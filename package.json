{
  "name": "eslint-config-upleveled",
  "version": "10.0.4",
  "description": "UpLeveled ESLint defaults for programming in JavaScript, TypeScript, React, Next.js, Node.js, Postgres.js",
  "keywords": [
    "eslint",
    "eslintconfig",
    "config",
    "javascript",
    "typescript",
    "react",
    "nextjs",
    "nodejs"
  ],
  "repository": "upleveled/eslint-config-upleveled",
  "license": "MIT",
  "author": "UpLeveled",
  "contributors": [
    "Jose Höwer <josehower@gmail.com>",
    "Karl Horky <karl.horky@gmail.com>"
  ],
  "type": "module",
  "main": "index.js",
  "bin": {
    "upleveled-eslint-install": "bin/install.js"
  },
  "files": [
    "bin",
    "templates",
    "index.js",
    "index.d.ts",
    "tsconfig.base.json"
  ],
  "scripts": {
    "postpublish": "./scripts/waitForNpmPublish.ts && cd __tests__ && pnpm update-config-version"
  },
  "dependencies": {
    "@eslint/compat": "2.1.1",
    "@next/eslint-plugin-next": "16.3.5",
    "@stylistic/eslint-plugin": "5.10.0",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "comment-json": "5.0.0",
    "eslint-config-flat-gitignore": "2.4.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-dom": "2.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-naming-convention": "2.13.0",
    "eslint-plugin-react-x": "2.13.0",
    "eslint-plugin-security": "4.0.1",
    "eslint-plugin-sonarjs": "4.2.1",
    "eslint-plugin-unicorn": "75.0.0",
    "eslint-plugin-upleveled": "2.1.15",
    "is-plain-obj": "4.1.0",
    "sort-package-json": "4.0.0",
    "strip-json-comments": "5.0.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@typescript-eslint/utils": "8.70.0",
    "eslint-config-upleveled": "10.0.4",
    "prettier": "3.9.8",
    "prettier-plugin-embed": "0.5.1",
    "prettier-plugin-sql": "0.20.0",
    "stylelint": "17.15.0",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@types/node": ">=26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0",
      "onFail": "download"
    }
  }
}
